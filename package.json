{
  "name": "beabot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "node scripts/pre-build-check.js && npm run test:content && npm run test:node",
    "test:content": "node scripts/check-content-queries.mjs",
    "test:node": "node --test tests/*.test.mjs",
    "prebuild": "npm run test",
    "pregenerate": "npm run test",
    "lint:js": "ESLINT_USE_FLAT_CONFIG=false eslint --ext \".js,.ts,.vue\" --ignore-path .gitignore .",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:prettier",
    "lintfix": "prettier --write --list-different . && npm run lint:js -- --fix",
    "migrate:frontmatter": "node scripts/migrate-frontmatter-seo.mjs"
  },
  "dependencies": {
    "@nuxt/content": "3.13.0",
    "@nuxt/image": "^1.8.1",
    "@nuxtjs/sitemap": "^6.1.1",
    "nuxt": "4.4.2",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.5.7",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.29.1",
    "gray-matter": "^4.0.3",
    "prettier": "^3.3.3",
    "sass": "^1.80.7",
    "sass-loader": "^16.0.3",
    "vite": "^6.0.1"
  },
  "packageManager": "npm@10.8.2"
}
